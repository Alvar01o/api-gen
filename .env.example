# ======================
# Anthropic (Claude API)
# ======================
# Usado como fallback para detectar la tabla de usuarios en schemas desconocidos
ANTHROPIC_API_KEY=sk-ant-...

# ======================
# App database (MikroORM)
# ======================
# Base de datos interna de la aplicación (usuarios, jobs, APIs generadas, tenants)
APP_DB_HOST=app-db          # nombre del servicio Docker / localhost en dev local
APP_DB_PORT=5432
APP_DB_USER=app
APP_DB_PASSWORD=apppass
APP_DB_NAME=appdyn

# ======================
# Admin inicial
# ======================
# Creado automáticamente al arrancar si no existe
ADMIN_EMAIL=admin@apidyn.dev
ADMIN_PASSWORD=Admin1234!

# ======================
# Autenticación JWT
# ======================
# Compartido entre la API principal y el Lambda Service para firmar/verificar tokens
JWT_SECRET=change_me_in_production_use_a_long_random_string

# ======================
# Autenticación — APIs serverless (Lambda)
# ======================
# Prefijo del endpoint de login generado para evitar colisión con tablas llamadas "auth"
LAMBDA_AUTH_PREFIX=auth-api-dyn
# Expiración de los tokens emitidos por el Lambda (la API principal usa 7d hardcoded)
JWT_EXPIRES_IN=8h

# ======================
# PostgreSQL target
# ======================
# Instancia donde se crean los schemas de los usuarios
POSTGRES_HOST=postgres       # nombre del servicio Docker / localhost en dev local
POSTGRES_PORT=5432
POSTGRES_USER=dev
POSTGRES_PASSWORD=devpass

# ======================
# MySQL target
# ======================
MYSQL_HOST=mysql             # nombre del servicio Docker / localhost en dev local
MYSQL_PORT=3306
MYSQL_USER=dev
MYSQL_PASSWORD=devpass

# ======================
# Redis
# ======================
REDIS_HOST=redis             # nombre del servicio Docker / localhost en dev local
REDIS_PORT=6379

# ======================
# SMTP (formulario de contacto)
# ======================
# Gmail: activar "Contraseñas de aplicación" en la cuenta Google (requiere 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx  # app password de 16 caracteres
CONTACT_TO_EMAIL=tu@gmail.com

# ======================
# Upload / rutas temporales
# ======================
SCHEMA_TMP_PATH=/tmp/schemas          # subdirectorio /<tenantId>/ se crea automáticamente
MAX_SCHEMA_FILE_SIZE=0                # bytes — 0 = ilimitado
SCHEMA_JOB_STORE_PATH=/tmp/schema-jobs

# ======================
# Comportamiento del schema
# ======================
DELETE_SCHEMA_AFTER_APPLY=true        # elimina el .sql después de un apply exitoso
SCHEMA_DROP_DB_ON_FAILURE=true        # elimina la DB creada si el apply falla
SCHEMA_USE_TRANSACTION=true           # envuelve el apply en una transacción
SCHEMA_FAIL_IF_DB_EXISTS=true         # rechaza si la DB destino ya existe
SCHEMA_DEDUPLICATE_BY_HASH=true       # omite el job si el mismo hash SHA-256 ya fue exitoso
SCHEMA_DRY_RUN=false                  # solo valida y sanitiza, no crea DB ni aplica

# ======================
# Timeouts (PostgreSQL)
# ======================
SCHEMA_STATEMENT_TIMEOUT_MS=60000
SCHEMA_CONNECT_TIMEOUT_MS=10000

# ======================
# SQL Guard
# ======================
SCHEMA_ENABLE_SQL_GUARD=true
SCHEMA_FORBIDDEN_KEYWORDS=DROP DATABASE,USE ,GRANT ,REVOKE ,ALTER USER

# ======================
# Rate limiting
# ======================
RATE_LIMIT_WINDOW_MS=60000   # ventana en ms
RATE_LIMIT_MAX=10            # máximo de requests por ventana en /schema/upload

# ======================
# Idempotencia
# ======================
SCHEMA_ENABLE_IDEMPOTENCY=true

# ======================
# WebSocket — progreso en tiempo real
# ======================
SCHEMA_ENABLE_WS_PROGRESS=true
SCHEMA_PROGRESS_CHANNEL_PREFIX=schema:progress:

# ======================
# CORS
# ======================
CORS_ORIGIN=*   # cambiar al dominio real en producción (ej. https://mi-app.com)

# ======================
# Monitoreo — Grafana
# ======================
GRAFANA_PASSWORD=admin       # cambiar en producción
